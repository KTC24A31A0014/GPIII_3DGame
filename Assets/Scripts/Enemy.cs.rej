@@ -44,5 +48,31 @@ public class Enemy : MonoBehaviour
             transform.forward = Vector3.Slerp(forward, rotateTarget,
                 rotateSpeed * Time.deltaTime);
         }
+
+        // 無敵時間を減らす
+        if(invincibleTime > 0)
+        {
+            invincibleTime -= Time.deltaTime;
